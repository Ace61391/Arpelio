# Online quizzes. Leave all three unset and the feature stays switched off (no sign-in, no share step).
# Setup guide: docs/online-quizzes-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional.
# NEXT_PUBLIC_ARPELIO_EMAIL_SIGNIN=off        # Google sign-in only, until a mail service is connected
# NEXT_PUBLIC_ARPELIO_DATA_REGION=the United States   # shown on the privacy page

# Local development without Supabase (in-memory database, fake sign-in). Use `npm run dev:quiz`.
# ARPELIO_LOCAL=1
# NEXT_PUBLIC_ARPELIO_LOCAL=1
